{
  "name": "brevis",
  "version": "2.0.0",
  "type": "module",
  "description": "BREVIS - Newsletter management with AI summaries and reports",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "vite build --config web/vite.config.js",
    "dev:web": "vite --config web/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node migrations/run-migrations.js",
    "agents:hello": "node agents/runtime/cli.js hello",
    "agents:editor:dryrun": "node agents/runtime/cli.js editor:dryrun"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.1",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.57.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dompurify": "^3.4.9",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.4",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.11",
    "openai": "^4.24.1",
    "pdf-parse": "^1.1.4",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rss-parser": "^3.13.0",
    "stripe": "^14.10.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@vitejs/plugin-react": "^6.0.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
