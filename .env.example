# Personal Brief Configuration

# Server
PORT=3000
NODE_ENV=development

# Logging: error | warn | info | debug (default: info in production, debug otherwise)
LOG_LEVEL=

# Sentry error tracking (optional — inert when unset). Create a project at
# sentry.io and paste its DSN.
SENTRY_DSN=

# Prometheus metrics: GET /metrics with "Authorization: Bearer <token>".
# Endpoint stays 404 until this is set.
METRICS_TOKEN=

# Database (PostgreSQL)
# For Railway: Use the DATABASE_URL provided by Railway PostgreSQL addon
DATABASE_URL=postgresql://user:password@localhost:5432/brevis
# Set to 'false' ONLY if your managed Postgres uses a self-signed cert (default: true in production)
DATABASE_SSL_VERIFY=

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Optional invite code — signups providing it get the premium plan
ACCESS_CODE=

# Initial admin user (only used when the users table is empty at startup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Claude AI API (para resúmenes)
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=tu-api-key-aqui

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000

# Email Domain (dominio para recibir newsletters via SendGrid)
# Usa tu subdominio verificado en SendGrid
EMAIL_DOMAIN=mail.brevisapp.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_ANNUAL=price_xxx

# Outbound email (verification, password reset, Kindle).
# Preferred: SendGrid API key. Fallback: the SMTP_* settings below.
SENDGRID_API_KEY=

# SMTP fallback for transactional emails
# For Google Workspace: use App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@brevisapp.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=info@brevisapp.com

# Email webhook secret (for SendGrid inbound parse)
EMAIL_WEBHOOK_SECRET=your-webhook-secret

# OpenAI for Text-to-Speech (opcional - para función de audio)
OPENAI_API_KEY=sk-xxx

# Google OAuth (opcional - para login con Google)
# Configura en: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://brevisapp.com/api/auth/google/callback
