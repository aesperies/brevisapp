# Personal Brief Configuration

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# For Railway: Use the DATABASE_URL provided by Railway PostgreSQL addon
DATABASE_URL=postgresql://user:password@localhost:5432/brevis

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Claude AI API (para resúmenes)
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=tu-api-key-aqui

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000

# Email Domain (opcional - para mostrar tu dominio personalizado)
EMAIL_DOMAIN=personalbrief.com

# IMAP Settings (opcional - solo si usas IMAP en lugar de webhooks)
# Deja en blanco si usas webhooks de email services
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Email Configuration
EMAIL_DOMAIN=newsletters.yourbrief.com
# For SendGrid: Use your verified subdomain
# Example: newsletters.personalbrief.com

# Stripe (optional - configure when ready)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Plans
FREE_LIMIT=10
PRO_LIMIT=31
PRO_PRICE=9.99
PREMIUM_PRICE=19.99
